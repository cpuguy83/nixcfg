+    // Mirrors the "pairing is open" state to the daemon, which is what actually
+    // gates whether a pair_request may spawn a focus-grabbing dialog (see
+    // net.cpp). Pairing is only ever allowed while this window is visible and
+    // its Devices tab is the one showing, so closing the app, hiding it to the
+    // tray, or switching tabs all close the window automatically.
+    bool g_pairing_mode_last_sent = false;
+
+    void sync_pairing_mode() {
+        GtkWidget* window = main_window();
+        const bool visible = window && gtk_widget_get_visible(window);
+        const bool on_devices_tab =
+            g_stack && g_strcmp0(gtk_stack_get_visible_child_name(GTK_STACK(g_stack)), "devices") == 0;
+        const bool want = visible && on_devices_tab;
+        if (want == g_pairing_mode_last_sent)
+            return;
+        g_pairing_mode_last_sent = want;
+        daemon_send(nlohmann::json{{"command", "pairing_mode_set"}, {"enabled", want}});
+    }
