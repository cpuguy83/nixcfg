+/// Rewrite the redirect URI in a broker request to the WAM broker redirect
+/// (`ms-appx-web://microsoft.aad.brokerplugin/<client_id>`). MSAL sends the
+/// public-client native redirect (`.../oauth2/nativeclient`), which third-party
+/// apps have not registered, so AAD rejects the PRT redemption with AADSTS50011
+/// ("Failed to authenticate user"). AAD implicitly trusts the WAM broker
+/// redirect for any broker-enabled public client, so redeeming under it
+/// succeeds. On any parse failure the original request is returned unchanged.
+fn rewrite_broker_redirect_uri(request_json: String) -> String {
+    serde_json::from_str::<serde_json::Value>(&request_json)
+        .ok()
+        .and_then(|mut v| {
+            let client_id = v
+                .get("authParameters")
+                .and_then(|ap| ap.get("clientId"))
+                .and_then(|c| c.as_str())?
+                .to_string();
+            let redirect = format!("ms-appx-web://microsoft.aad.brokerplugin/{}", client_id);
+            v.get_mut("authParameters")
+                .and_then(|ap| ap.as_object_mut())?
+                .insert("redirectUri".to_string(), serde_json::Value::String(redirect));
+            serde_json::to_string(&v).ok()
+        })
+        .unwrap_or(request_json)
+}
+
+/// Ensure the request carries the resolved account so the daemon's silent path
+/// (which matches account.username against the enrolled user) accepts it even
+/// when MSAL left the account null. No-op when a non-empty username is present.
+fn inject_account(request_json: String, account: &serde_json::Value) -> String {
+    serde_json::from_str::<serde_json::Value>(&request_json)
+        .ok()
+        .and_then(|mut v| {
+            let has_account = v
+                .get("account")
+                .and_then(|a| a.get("username"))
+                .and_then(|u| u.as_str())
+                .is_some_and(|u| !u.is_empty());
+            if !has_account {
+                v.as_object_mut()?
+                    .insert("account".to_string(), account.clone());
+            }
+            serde_json::to_string(&v).ok()
+        })
+        .unwrap_or(request_json)
+}
